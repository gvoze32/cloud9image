# Copy this file to .env, then replace the placeholder password.
# Keep bind addresses on 127.0.0.1 unless protected by a reverse proxy or VPN.
# On Apple Silicon, use gvoze32/cloud9:arm64v8-resolute for CLOUD9_IMAGE.
#
# Cloud9
CLOUD9_IMAGE=gvoze32/cloud9:latest
CLOUD9_BIND_ADDRESS=127.0.0.1
CLOUD9_PORT=8000
CLOUD9_USERNAME=admin
CLOUD9_PASSWORD=change-this-cloud9-password
CLOUD9_GITURL=

# Hermes
HERMES_IMAGE=nousresearch/hermes-agent:latest
HERMES_UID=1000
HERMES_GID=1000
HERMES_BIND_ADDRESS=127.0.0.1
HERMES_API_PORT=8642
HERMES_DASHBOARD_PORT=9119
# Enable the dashboard only after setting all three auth values below.
HERMES_DASHBOARD=0
HERMES_DASHBOARD_HOST=0.0.0.0
HERMES_DASHBOARD_BASIC_AUTH_USERNAME=
HERMES_DASHBOARD_BASIC_AUTH_PASSWORD=
HERMES_DASHBOARD_BASIC_AUTH_SECRET=
HERMES_API_SERVER_ENABLED=false
HERMES_API_SERVER_HOST=0.0.0.0
HERMES_API_SERVER_KEY=
